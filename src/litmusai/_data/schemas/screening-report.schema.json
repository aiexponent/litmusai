    "GenerativeMedia": {
      "additionalProperties": false,
      "description": "Capabilities that Art. 5(1)(ba) and (bb) turn on, as inserted by\nRegulation (EU) 2026/1744 and read with Art. 5(1a) and (1b).\n\nSet a flag to true when it holds for the system as shipped, without\nsignificant technical modification (Art. 5(1a)(a)(ii)).",
      "properties": {
        "realistic_media_generation": {
          "default": false,
          "title": "Realistic Media Generation",
          "type": "boolean"
        },
        "identifiable_persons": {
          "default": false,
          "title": "Identifiable Persons",
          "type": "boolean"
        },
        "intimate_depictions_possible": {
          "default": false,
          "title": "Intimate Depictions Possible",
          "type": "boolean"
        },
        "intimate_depictions_intended": {
          "default": false,
          "title": "Intimate Depictions Intended",
          "type": "boolean"
        },
        "minors_depictions_possible": {
          "default": false,
          "title": "Minors Depictions Possible",
          "type": "boolean"
        },
        "manipulation_within_1b_only": {
          "default": false,
          "title": "Manipulation Within 1B Only",
          "type": "boolean"
        },
        "safeguards": {
          "$ref": "#/$defs/GenerativeMediaSafeguards",
          "default": {
            "consent_demonstrable": false,
            "intimate_output_prevention": false,
            "csam_prevention": false,
            "misuse_correction": false,
            "documented": false
          }
        }
      },
      "title": "GenerativeMedia",
      "type": "object"
    },
    "GenerativeMediaSafeguards": {
      "additionalProperties": false,
      "description": "Technical safety measures and other safeguards, Art. 5(1a)(a)(ii).\n\nEvery flag means \"in place, in force and verifiable\", not \"planned\".",
      "properties": {
        "consent_demonstrable": {
          "default": false,
          "title": "Consent Demonstrable",
          "type": "boolean"
        },
        "intimate_output_prevention": {
          "default": false,
          "title": "Intimate Output Prevention",
          "type": "boolean"
        },
        "csam_prevention": {
          "default": false,
          "title": "Csam Prevention",
          "type": "boolean"
        },
        "misuse_correction": {
          "default": false,
          "title": "Misuse Correction",
          "type": "boolean"
        },
        "documented": {
          "default": false,
          "title": "Documented",
          "type": "boolean"
        }
      },
      "title": "GenerativeMediaSafeguards",
      "type": "object"
    },
    "Influence": {
      "additionalProperties": false,
      "description": "The elements of Art. 5(1)(a) and (b), one question each.\n\nAnswer for the system as placed on the market, put into service or used.\nPoint (a) needs a technique, material distortion and significant harm;\npoint (b) needs exploitation of a vulnerability, material distortion and\nsignificant harm.",
      "properties": {
        "subliminal_techniques": {
          "default": "not_answered",
          "enum": [
            "yes",
            "no",
            "not_sure",
            "not_answered"
          ],
          "title": "Subliminal Techniques",
          "type": "string"
        },
        "manipulative_or_deceptive_techniques": {
          "default": "not_answered",
          "enum": [
            "yes",
            "no",
            "not_sure",
            "not_answered"
          ],
          "title": "Manipulative Or Deceptive Techniques",
          "type": "string"
        },
        "exploits_vulnerability": {
          "default": "not_answered",
          "enum": [
            "yes",
            "no",
            "not_sure",
            "not_answered"
          ],
          "title": "Exploits Vulnerability",
          "type": "string"
        },
        "materially_distorts_behaviour": {
          "default": "not_answered",
          "enum": [
            "yes",
            "no",
            "not_sure",
            "not_answered"
          ],
          "title": "Materially Distorts Behaviour",
          "type": "string"
        },
        "significant_harm_likely": {
          "default": "not_answered",
          "enum": [
            "yes",
            "no",
            "not_sure",
            "not_answered"
          ],
          "title": "Significant Harm Likely",
          "type": "string"
        }
      },
      "title": "Influence",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "last_reviewed": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Reviewed"
        },
        "owner": {
          "anyOf": [
