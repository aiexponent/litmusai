{
  "$defs": {
    "CategoryResult": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "clear",
            "amber",
            "red"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "triggered_rules": {
          "items": {
            "type": "string"
          },
          "title": "Triggered Rules",
          "type": "array"
        },
        "regulation_citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Regulation Citations",
          "type": "array"
        },
        "remediation": {
          "items": {
            "type": "string"
          },
          "title": "Remediation",
          "type": "array"
        }
      },
      "required": [
        "label",
        "verdict",
        "confidence",
        "rationale"
      ],
      "title": "CategoryResult",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "article": {
          "minLength": 1,
          "title": "Article",
          "type": "string"
        },
        "recital": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recital"
        }
      },
      "required": [
        "article"
      ],
      "title": "Citation",
      "type": "object"
    },
    "DeploymentContext": {
