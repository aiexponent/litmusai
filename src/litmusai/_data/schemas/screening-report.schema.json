    "Scope": {
      "additionalProperties": false,
      "description": "Exceptions and limits written in Art. 5(1), points (d) to (h).\n\nA \"no\" that takes the system outside a prohibition clears that point.\nA \"yes\" to an exception that needs evidence gives amber for review.",
      "properties": {
        "role": {
          "default": "both",
          "enum": [
            "provider_only",
            "deployer",
            "both"
          ],
          "title": "Role",
          "type": "string"
        },
        "human_assessment_on_verifiable_facts": {
          "default": "not_answered",
          "enum": [
            "yes",
            "no",
            "not_sure",
            "not_answered"
          ],
          "title": "Human Assessment On Verifiable Facts",
          "type": "string"
        },
        "untargeted_collection": {
          "default": "not_answered",
          "enum": [
            "yes",
            "no",
            "not_sure",
            "not_answered"
          ],
          "title": "Untargeted Collection",
          "type": "string"
        },
        "builds_facial_recognition_database": {
          "default": "not_answered",
          "enum": [
            "yes",
            "no",
            "not_sure",
            "not_answered"
          ],
          "title": "Builds Facial Recognition Database",
          "type": "string"
        },
        "emotions_of_workers_or_students": {
          "default": "not_answered",
          "enum": [
            "yes",
            "no",
            "not_sure",
            "not_answered"
          ],
          "title": "Emotions Of Workers Or Students",
          "type": "string"
        },
        "medical_or_safety_reasons": {
          "default": "not_answered",
          "enum": [
            "yes",
            "no",
            "not_sure",
            "not_answered"
          ],
          "title": "Medical Or Safety Reasons",
          "type": "string"
        },
        "dataset_labelling_or_filtering_only": {
          "default": "not_answered",
          "enum": [
            "yes",
            "no",
            "not_sure",
            "not_answered"
          ],
          "title": "Dataset Labelling Or Filtering Only",
          "type": "string"
        },
        "remote_identification": {
          "default": "not_answered",
          "enum": [
            "yes",
            "no",
            "not_sure",
            "not_answered"
          ],
          "title": "Remote Identification",
          "type": "string"
        },
        "law_enforcement_purpose": {
          "default": "not_answered",
          "enum": [
            "yes",
            "no",
            "not_sure",
            "not_answered"
