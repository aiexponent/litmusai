        "article_5_1_h_objective": {
          "default": "not_answered",
          "enum": [
            "yes",
            "no",
            "not_sure",
            "not_answered"
          ],
          "title": "Article 5 1 H Objective",
          "type": "string"
        }
      },
      "title": "Scope",
      "type": "object"
    },
